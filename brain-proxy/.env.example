# brain-proxy settings. Copy to ~/vector-brain/.env (start.sh sources it) and
# fill in the placeholders. Every value is optional; defaults are shown.

# --- core ---
OLLAMA_URL=http://127.0.0.1:11434
WIREPOD_URL=http://127.0.0.1:8080
VECTOR_BRAIN_PORT=11500
VECTOR_ESN=YOUR_ESN
VECTOR_TIMEZONE=America/New_York
# speaker label your conversation logger writes for the owner's turns
VECTOR_OWNER_LOG_LABEL=Owner
VISION_MODEL=gemma3:4b
VISION_NUM_GPU=-1
OLLAMA_KEEP_ALIVE_VALUE=24h

# --- paths ---
VECTOR_VAULT_ROOT=~/obsidian-brain
VECTOR_BRAIN_INDEX_DIR=~/vector-brain/index
VECTOR_BRAIN_LOG_PATH=~/vector-brain/brain.log
VECTOR_MOOD_PATH=~/vector-brain/mood.json
VECTOR_RECENT_OBSERVATION_PATH=~/vector-brain/recent_observation.txt
VECTOR_METRICS_PATH=~/vector-brain/metrics/turns.jsonl
VECTOR_LESSONS_PATH=~/vector-brain/training/lessons.jsonl
VECTOR_CURRENT_PEOPLE_PATH=~/vector-faces/current_people.json

# --- camera brightening (brighten.py) ---
BRIGHTEN_IMAGES=1
#BRIGHTEN_TARGET_MEAN=
#BRIGHTEN_MAX_GAIN=
#BRIGHTEN_DARK_MEAN=
#BRIGHTEN_BLACK_MEAN=
#BRIGHTEN_WB=

# --- optional escalation to a bigger remote assistant ("Hermes" in the code) ---
# The shared secret lives in a separate KEY=VALUE file (VECTOR_ENV_PATH), chmod 600:
#   VECTOR_ASK_URL=http://ASSISTANT_HOST_IP:8791/ask
#   VECTOR_ASK_TOKEN=<long random string, e.g. `openssl rand -hex 32`>
VECTOR_ENV_PATH=~/vector-pod/data/vector-bridge/vector.env
VECTOR_ESCALATION_URL_DEFAULT=http://ASSISTANT_HOST_IP:8791/ask
HERMES_ESCALATION_ENABLED=0
HERMES_ASK_TIMEOUT_SECONDS=20
HERMES_ESCALATION_MIN_INTERVAL_SECONDS=30
HERMES_ESCALATION_LOCAL_SIM=0.55
HERMES_ESCALATION_EXTRA_KEYWORDS=
