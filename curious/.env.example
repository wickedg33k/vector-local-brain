# vector-curious reads most settings from config.json (copy
# config.example.json -> config.json). These are passed as container env by run.sh:
VECTOR_OWNER_NAME=friend
# comma-separated names that must never appear in a spoken question
# (household members who usually aren't in the room)
VECTOR_DISALLOWED_NAMES=
# Optional sentry/safety alerts via Home Assistant: put a long-lived access
# token in /app/.ha_token (chmod 600, git-ignored) -- never in config.json.
