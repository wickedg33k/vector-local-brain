+package wirepod_ttr
+
+import (
+	"testing"
+	"time"
+)
+
+// TestWakeWordInterruptShouldIgnore covers the Bug 1 fix (2026-09-29):
+// a wake_word event delivered shortly after the interrupt watcher starts
+// is treated as a stale/echoed delivery of the turn's OWN triggering wake
+// word (or a synthetic engine signal from clearing stale trigger-word
+// state) rather than a genuine new interrupt, per the 16:04 UTC
+// "remember what I asked you a minute ago" incident.
+func TestWakeWordInterruptShouldIgnore(t *testing.T) {
+	const grace = 1500 * time.Millisecond
+	cases := []struct {
+		name string
+		in   time.Duration
+		want bool
+	}{
+		{"immediately after watcher start", 0, true},
+		{"well within grace period", 500 * time.Millisecond, true},
+		{"just under grace period", grace - time.Millisecond, true},
+		{"exactly at grace period boundary", grace, false},
+		{"well after grace period", 5 * time.Second, false},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			got := wakeWordInterruptShouldIgnore(c.in, grace)
+			if got != c.want {
+				t.Errorf("wakeWordInterruptShouldIgnore(%v, %v) = %v, want %v", c.in, grace, got, c.want)
+			}
+		})
+	}
+}
