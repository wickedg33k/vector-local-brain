 }
+
+// wakeWordInterruptShouldIgnore is the pure grace-period decision behind
+// the Event_WakeWord case above, split out 2026-09-29 (Bug 1 fix) so it's
+// directly unit-testable with no gRPC stream/robot connection required --
+// same pattern as bcontrol.go's behaviorControlShouldRelease. A wake_word
+// event arriving before sinceWatcherStart reaches gracePeriod is treated
+// as stale/echoed (see the fix comment above) and ignored; at or after the
+// grace period it's a genuine interrupt.
+func wakeWordInterruptShouldIgnore(sinceWatcherStart, gracePeriod time.Duration) bool {
+	return sinceWatcherStart < gracePeriod
+}
