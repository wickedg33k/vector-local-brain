+package wirepod_ttr
+
+// e2e_llm_timing_test.go -- added 2026-09-30 (live-16 incremental rebuild,
+// Hermes) as the per-step end-to-end LATENCY gate the owner asked for: "must
+// not interfere with STT" (step 2) and "end-to-end latency must be <= live-9's
+// for the same clips" (all steps). This measures the part of the pipeline
+// that actually determines whether the robot hears anything within its
+// ~9.2s client-side cloud-intent timeout: how long CreateAIReq +
+// CreateChatCompletionStream takes to open against the REAL configured
+// backend (vector-brain proxy at :11500 -> Ollama), and how long until the
+// first content token and the full response arrive. Does NOT require a
+// real robot connection (CreateAIReq/CreateChatCompletionStream never touch
+// robot.Conn) -- STT timing itself is covered separately by the Vosk-level
+// e2e harness (pkg/wirepod/stt/vosk/Vosk_e2e_test.go), which is unaffected
+// by any of these 5 steps since none of them touch Vosk.go/speechrequest.go.
+//
+// Skipped by default (set E2E_LLM_LIVE=1 to run) since it makes a REAL
+// network call against the production Ollama/vector-brain backend and can
+// take anywhere from ~5s to several minutes per the observed brain.log tail
+// latency -- not something to run in a normal CI loop.
+
+import (
+	"context"
+	"errors"
+	"io"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/kercre123/wire-pod/chipper/pkg/vars"
+	openai "github.com/sashabaranov/go-openai"
+)
+
+func e2eLLMSetup(t *testing.T) {
+	t.Helper()
+	if os.Getenv("E2E_LLM_LIVE") == "" {
+		t.Skip("skipping: set E2E_LLM_LIVE=1 to exercise the real Ollama/vector-brain backend")
+	}
+	// Matches the REAL production apiConfig.json Knowledge block exactly
+	// (provider/endpoint/model/key) -- set directly on the in-memory
+	// vars.APIConfig struct, never touching the apiConfig.json file on
+	// disk (no WriteConfigToDisk call anywhere in this path for the
+	// "custom" provider branch).
+	vars.APIConfig.Knowledge.Enable = true
+	vars.APIConfig.Knowledge.Provider = "custom"
+	vars.APIConfig.Knowledge.Endpoint = "http://127.0.0.1:11500/v1"
+	vars.APIConfig.Knowledge.Key = "ollama"
+	vars.APIConfig.Knowledge.Model = "qwen3:32b"
+	vars.APIConfig.Knowledge.LLMFirst = true
+	vars.APIConfig.Knowledge.SaveChat = false
+	vars.APIConfig.Knowledge.OpenAIPrompt = "You are Vector, a small desk robot. Keep replies to 1-2 short sentences."
+}
+
+// e2eLLMPhrases are the real transcripts used for this step's latency gate
+// -- the same utterances espeak-ng generated for live15-e2e-audio/, so
+// timing here is directly comparable to what the Vosk harness actually
+// transcribes from those clips.
+var e2eLLMPhrases = []string{
+	"what's a texas rig",
+	"tell me a joke",
+	"free roam if you want",
+	"the fish are biting today",
+}
+
+func TestE2E_LLMTurnTiming(t *testing.T) {
+	e2eLLMSetup(t)
+	for _, p := range e2eLLMPhrases {
+		p := p
+		t.Run(p, func(t *testing.T) {
+			runLLMTimingCase(t, p)
+		})
+	}
+}
+
+// runLLMTimingCase is shared by the pre-classify (steps 1-3) and
+// post-classify (steps 4-5) variants of this test -- the classify variant
+// wraps this with its own ClassifyCommandIntent timing/short-circuit first.
+func runLLMTimingCase(t *testing.T, transcript string) {
+	t.Helper()
+	aireq := CreateAIReq(transcript, "e2e-timing-test", false, false)
+
+	conf := openai.DefaultConfig(vars.APIConfig.Knowledge.Key)
+	conf.BaseURL = vars.APIConfig.Knowledge.Endpoint
+	c := openai.NewClientWithConfig(conf)
+
+	streamStart := time.Now()
+	stream, err := c.CreateChatCompletionStream(context.Background(), aireq)
+	streamOpenElapsed := time.Since(streamStart)
+	if err != nil {
+		t.Fatalf("CreateChatCompletionStream error after %s: %v", streamOpenElapsed, err)
+	}
+	defer stream.Close()
+
+	var firstContentElapsed time.Duration
+	gotFirst := false
+	var fullDone time.Duration
+	chunks := 0
+	for {
+		resp, err := stream.Recv()
+		if errors.Is(err, io.EOF) {
+			fullDone = time.Since(streamStart)
+			break
+		}
+		if err != nil {
+			t.Fatalf("stream.Recv() error after %s (streamOpen=%s, firstContent=%s): %v", time.Since(streamStart), streamOpenElapsed, firstContentElapsed, err)
+		}
+		if len(resp.Choices) > 0 && resp.Choices[0].Delta.Content != "" {
+			chunks++
+			if !gotFirst {
+				firstContentElapsed = time.Since(streamStart)
+				gotFirst = true
+			}
+		}
+	}
+	t.Logf("%q: streamOpen=%s firstContent=%s fullDone=%s chunks=%d", transcript, streamOpenElapsed, firstContentElapsed, fullDone, chunks)
+	if !gotFirst {
+		t.Fatalf("%q: stream completed with EOF but no content was ever received", transcript)
+	}
+}
