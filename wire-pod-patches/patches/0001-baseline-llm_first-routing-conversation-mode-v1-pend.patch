+		// send failing right at release time is the same class of
+		// transient robot-unreachable condition this whole safety net is
+		// for -- don't give up on the first failure.
+		releaseControl := func(reason string) {
+			logger.Println("KGSim: releasing behavior control (" + reason + ")")
+			for attempt := 1; attempt <= releaseBehaviorControlRetries; attempt++ {
+				sendErr := r.Send(
 					&vectorpb.BehaviorControlRequest{
 						RequestType: &vectorpb.BehaviorControlRequest_ControlRelease{
 							ControlRelease: &vectorpb.ControlRelease{},
 						},
 					},
-				); err != nil {
-					logger.Println(err)
+				)
+				if sendErr == nil {
 					return
 				}
+				logger.Println("BControl: release attempt failed (" + sendErr.Error() + ")")
+				if attempt < releaseBehaviorControlRetries {
+					time.Sleep(releaseBehaviorControlRetryDelay)
+				}
+			}
+			logger.Println("BControl: giving up on releasing behavior control after retries")
+		}
+
+		// Fixed 2026-09-27 (Hermes): this used to be a busy-spin
+		// `for { select { case <-stop: ...; default: continue } }` with NO
