+// Behavior-control safety net, 2026-09-27 (Hermes). History:
+//   - First cut: a flat 30s deadline, after the owner's robot froze
+//     (buttons/movement stopped) when its Wi-Fi dropped mid-reply while
+//     wire-pod held OVERRIDE_BEHAVIORS and the normal release (the `stop`
+//     channel, sent once the response pipeline finishes) never arrived.
+//   - Found immediately after: the flat 30s ALSO fired during a legitimate
+//     reply -- a getImage turn (intro line -> capture -> ~6s vision model
+//     -> spoken answer) routinely exceeds 30s. Replaced with an adaptive
+//     watchdog: the deadline resets on every sign of real progress
+//     (TouchBehaviorControlActivity, called from PerformActions -- covers
+//     speech, animations, doIntent, everything it dispatches), with a
+//     30s+ absolute cap as the true "definitely stuck" ceiling. The
+//     original flat-30s freeze fix's actual safety property (control can
+//     never be held forever) is preserved by the absolute cap; the
+//     regression it caused is fixed by resetting on progress.
+const (
+	behaviorControlInactivityTimeout = 20 * time.Second // no progress for this long -> force-release
+	behaviorControlAbsoluteCap       = 90 * time.Second  // hard ceiling regardless of activity
+	behaviorControlWatchdogInterval  = 1 * time.Second   // how often the watchdog re-checks
+)
+
+// releaseBehaviorControlRetries/releaseBehaviorControlRetryDelay: how many
+// times (and how far apart) to retry sending ControlRelease if the first
+// attempt fails -- covers the same "robot briefly unreachable" case that
+// motivated this whole safety net, so a transient failure right at
+// release time doesn't leave control stuck forever either.
+const releaseBehaviorControlRetries = 3
+const releaseBehaviorControlRetryDelay = 2 * time.Second
+
+// behaviorControlActivity tracks, per ESN, the last time
+// TouchBehaviorControlActivity was called -- the inactivity watchdog reads
+// this to decide whether to force-release. Package-level (like
+// conversation.go's/pendingintent.go's per-ESN maps) since BControl only
+// has the robot connection, not a natural place to thread a channel through
+// every caller that might make progress.
+var (
+	behaviorControlActivity   = map[string]time.Time{}
+	behaviorControlActivityMu sync.Mutex
+)
+
+// TouchBehaviorControlActivity records that esn's held behavior control is
+// making real progress right now (a sentence was spoken, an animation
+// played, an action fired, ...), resetting the inactivity watchdog. Safe
+// to call even when no BControl watchdog is currently running for esn.
+func TouchBehaviorControlActivity(esn string) {
+	behaviorControlActivityMu.Lock()
+	defer behaviorControlActivityMu.Unlock()
+	behaviorControlActivity[esn] = time.Now()
+}
+
+func getBehaviorControlActivity(esn string) time.Time {
+	behaviorControlActivityMu.Lock()
+	defer behaviorControlActivityMu.Unlock()
+	return behaviorControlActivity[esn]
+}
+
+// behaviorControlShouldRelease is the pure watchdog decision, split out so
+// it's unit-testable without a real robot connection or timers: given how
+// long control has been held in total and how long since the last
+// progress touch, should the watchdog force a release? Returns the reason
+// string for logging when true.
+func behaviorControlShouldRelease(heldFor, sinceLastActivity, inactivityTimeout, absoluteCap time.Duration) (bool, string) {
+	if heldFor >= absoluteCap {
+		return true, "absolute cap"
+	}
+	if sinceLastActivity >= inactivityTimeout {
+		return true, "inactivity watchdog"
+	}
+	return false, ""
+}
+
