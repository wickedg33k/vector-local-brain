-			default:
-				continue
+			case <-ticker.C:
+				shouldRelease, reason := behaviorControlShouldRelease(
+					time.Since(heldSince),
+					time.Since(getBehaviorControlActivity(esn)),
+					behaviorControlInactivityTimeout,
+					behaviorControlAbsoluteCap,
