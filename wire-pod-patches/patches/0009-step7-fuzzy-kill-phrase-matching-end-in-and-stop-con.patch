+// of the generic exec-script path. Kept as a redundant fallback -- see the
+// 2026-10-15b file-header note for why MaybeHandleEndConversationCmd
+// (called earlier, from ProcessTextAll) is the real gate now.
 const EndConversationCmdCustomIntentName = "end_conversation_custom"
 
 // endConversationGoodbyeText is what Vector says back when the kill phrase
 // ends the conversation. Short and spoken directly -- no LLM call.
 const endConversationGoodbyeText = "Later!"
 
-// endConversationPhrases are the kill phrases that end conversation mode
-// immediately. Matched as a substring of the (already-lowercased, per
-// customIntentHandler's seekText convention) transcribed utterance, same
-// as every other custom intent in this package.
-var endConversationPhrases = []string{
-	"end conversation vector",
-	"end conversation",
+// endConversationExactPhrases are kill phrases that don't contain
+// "conversation" at all, so they can't be covered by
+// endConversationMarkerRe below -- matched as a plain substring of the
+// normalized (lowercased, trimmed) transcript.
+var endConversationExactPhrases = []string{
 	"that's all vector",
 	"thats all vector",
 	"goodbye vector",
 }
 
+// endConversationMarkerRe is the fuzzy match behind "end conversation"
+// style phrases. Vosk has been observed, in real production transcripts,
+// to mishear "end" as "in" (confirmed 3 times in a row, 2026-10-15) --
+// "and" is included too (a coordinator-flagged plausible mishearing of the
+// same word), and "stop" as a reasonable alternate phrasing a person might
+// actually say instead of "end". Matches either word order ("end
+// conversation" / "conversation ended" style callers aren't expected, but
+// the alternation covers a marker immediately before OR after
+// "conversation", with an optional "the" in between on the before side)
+// so "vector in conversation" (reordered relative to "in conversation
+// vector") also matches.
+var endConversationMarkerRe = regexp.MustCompile(
+	`\b(end|in|and|stop)\b(\s+the)?\s+conversation\b` +
+		`|\bconversation\b\s+(end|in|and|stop)\b`,
+)
+
+// endConversationMaxFuzzyWords caps how long an utterance can be and still
+// be eligible for the fuzzy marker-regex match above. Every real kill-
+// phrase variant seen or requested is 2-4 words ("in conversation",
+// "vector in conversation", "end the conversation", "and conversation
+// vector"); capping at 6 words keeps a long, unrelated sentence that
+// happens to contain "conversation" from accidentally matching. The
+// endConversationExactPhrases list above is NOT subject to this cap -- it
+// has no such accidental-substring risk since those phrases are more
+// distinctive.
+const endConversationMaxFuzzyWords = 6
+
+// normalizeEndConversationVoiceText lowercases and trims voiceText for
+// matching. Split out so the exact same normalization is used by both the
+// exact-phrase and fuzzy-regex checks, and is directly testable.
+func normalizeEndConversationVoiceText(voiceText string) string {
+	return strings.ToLower(strings.TrimSpace(voiceText))
+}
+
 // classifyEndConversationCmd is the pure phrase-matching decision behind
 // the kill phrase, split out so it's directly unit-testable with no
 // gRPC/HTTP/robot connection required -- same pattern as
 // classifySentryMode/decideConversationContinuation elsewhere in this
 // package.
 func classifyEndConversationCmd(voiceText string) bool {
-	lower := strings.ToLower(voiceText)
-	for _, phrase := range endConversationPhrases {
-		if strings.Contains(lower, phrase) {
+	normalized := normalizeEndConversationVoiceText(voiceText)
+	if normalized == "" {
+		return false
+	}
+	for _, phrase := range endConversationExactPhrases {
+		if strings.Contains(normalized, phrase) {
 			return true
 		}
 	}
-	return false
+	if len(strings.Fields(normalized)) > endConversationMaxFuzzyWords {
+		return false
+	}
+	return endConversationMarkerRe.MatchString(normalized)
 }
 
 // endConversationAckFn/endConversationGetRobotFn/endConversationSayFn are
@@ -89,12 +147,13 @@ var (
