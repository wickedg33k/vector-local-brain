+// TestMaybeHandleEndConversationCmd_Match verifies the ProcessTextAll-level
+// gate: a match runs the full orchestration and returns true.
+func TestMaybeHandleEndConversationCmd_Match(t *testing.T) {
+	const esn = "test-esn-maybehandle-match"
+	placeConversationState(ConversationState{ESN: esn, Active: true, ListenCount: 5})
+
+	var events []string
+	origAck, origGetRobot, origSay := endConversationAckFn, endConversationGetRobotFn, endConversationSayFn
+	defer func() {
+		endConversationAckFn, endConversationGetRobotFn, endConversationSayFn = origAck, origGetRobot, origSay
+		EndConversation(esn)
+	}()
+	endConversationAckFn = func(req interface{}, voiceText string) { events = append(events, "ack") }
+	endConversationGetRobotFn = func(botSerial string) (*vector.Vector, error) {
+		events = append(events, "getrobot")
+		return nil, nil
+	}
+	endConversationSayFn = func(robot *vector.Vector, text string) { events = append(events, "say:"+text) }
+
+	got := MaybeHandleEndConversationCmd(nil, "in conversation vector", esn)
+	if !got {
+		t.Fatalf("MaybeHandleEndConversationCmd returned false, want true for a real mishearing match")
+	}
+	want := []string{"ack", "getrobot", "say:" + endConversationGoodbyeText}
+	if len(events) != len(want) {
+		t.Fatalf("events = %v, want %v", events, want)
+	}
+}
+
+// TestMaybeHandleEndConversationCmd_NoMatch verifies the gate is a
+// pure pass-through (no side effects, returns false) on ordinary speech,
+// so callers safely continue their normal dispatch.
+func TestMaybeHandleEndConversationCmd_NoMatch(t *testing.T) {
+	var called bool
+	origAck := endConversationAckFn
+	defer func() { endConversationAckFn = origAck }()
+	endConversationAckFn = func(req interface{}, voiceText string) { called = true }
+
+	got := MaybeHandleEndConversationCmd(nil, "what's the weather today", "test-esn-nomatch")
+	if got {
+		t.Fatalf("MaybeHandleEndConversationCmd returned true for unrelated speech")
+	}
+	if called {
+		t.Fatalf("ack was called even though nothing matched")
+	}
+}
