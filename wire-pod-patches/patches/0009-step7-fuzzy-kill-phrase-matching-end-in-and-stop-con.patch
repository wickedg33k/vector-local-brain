-// intent stream immediately, resets any tracked conversation state for
-// this ESN (so no further auto-listen can fire), then speaks the goodbye
-// directly -- no LLM call, no further listen triggered.
+// handleEndConversationCmd is the shared orchestration for ending the
+// conversation on a kill-phrase match: acks the intent stream immediately,
+// resets any tracked conversation state for this ESN (so no further
+// auto-listen can fire), then speaks the goodbye directly -- no LLM call,
+// no further listen triggered. Called both from
+// MaybeHandleEndConversationCmd (the real gate, see file header) and from
+// customIntentHandler's redundant fallback case.
 func handleEndConversationCmd(req interface{}, botSerial, voiceText string) {
 	endConversationAckFn(req, voiceText)
 
@@ -111,3 +170,18 @@ func handleEndConversationCmd(req interface{}, botSerial, voiceText string) {
 	}
 	endConversationSayFn(robot, endConversationGoodbyeText)
 }
+
+// MaybeHandleEndConversationCmd is the primary kill-phrase gate, called
+// from the very top of ProcessTextAll (matchIntentSend.go) -- before
+// plugins, custom intents, CORE/SOCIAL keyphrase matching, the fast
+// classifier, and the LLM chat path, so a misheard-but-still-recognizable
+// kill phrase can never be swallowed by any of them. Returns true (and
+// has already fully handled the turn) on a match; false otherwise, in
+// which case the caller should continue its normal dispatch.
+func MaybeHandleEndConversationCmd(req interface{}, voiceText, botSerial string) bool {
+	if !classifyEndConversationCmd(voiceText) {
+		return false
+	}
+	handleEndConversationCmd(req, botSerial, voiceText)
+	return true
+}
